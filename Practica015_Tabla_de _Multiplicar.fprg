    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Tabla de Multiplicar&#13;&#10;Escribe un algoritmo que pida un n&#250;mero al usuario y muestre su tabla de multiplicar del 1 al 10."/>
            <declare name="nom" type="Integer" array="False" size=""/>
            <declare name="itera" type="Integer" array="False" size=""/>
            <declare name="inicio" type="Integer" array="False" size=""/>
            <declare name="fin" type="Integer" array="False" size=""/>
            <declare name="resul" type="Integer" array="False" size=""/>
            <assign variable="inicio" expression="1"/>
            <assign variable="fin" expression="10"/>
            <assign variable="itera" expression="inicio"/>
            <output expression="&quot;Escribe un n&#250;mero&quot;" newline="True"/>
            <input variable="nom"/>
            <for variable="itera" start="inicio" end="fin" direction="inc" step="1">
                <assign variable="resul" expression="nom * itera"/>
                <output expression="&quot;El valor de &quot; &amp; nom &amp; &quot; por &quot; &amp; itera &amp; &quot; es &quot; &amp; resul" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
