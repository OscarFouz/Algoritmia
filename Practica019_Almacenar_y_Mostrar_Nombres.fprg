        <attribute name="edited" value="QWx1bW5lX3RhcmRhMTtMVDJCUzIzNDUyOzIwMjUtMDktMTc7MDU6MjU6MTYgcC4gbS47MTA7MzUyNg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Almacenar y Mostrar Nombres&#13;&#10;Crea un algoritmo que pida al usuario 3 nombres de amigos y los guarde en un array. Despu&#233;s, muestra cada nombre en una l&#237;nea separada."/>
            <declare name="Matriz" type="String" array="True" size="3"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="2" direction="inc" step="1">
                <output expression="&quot;Escribe un nombre&quot;" newline="True"/>
                <input variable="Matriz[i]"/>
            </for>
            <for variable="i" start="0" end="2" direction="inc" step="1">
                <output expression="&quot;El nombre n&#250;mero &quot; &amp; i + 1 &amp; &quot; es &quot; &amp; Matriz[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
