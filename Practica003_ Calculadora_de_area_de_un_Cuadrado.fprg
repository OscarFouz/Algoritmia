    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text=" Calculadora de &#193;rea de un Cuadrado&#13;&#10;Crea un algoritmo que pida al usuario la longitud de un lado de un cuadrado y luego muestre su &#225;rea.&#13;&#10;"/>
            <output expression="&quot;Entra un valor de la longitud de un lado de un cuadrado&quot;" newline="True"/>
            <declare name="lonLado" type="Integer" array="False" size=""/>
            <declare name="area" type="Integer" array="False" size=""/>
            <input variable="lonLado"/>
            <assign variable="area" expression="lonLado * lonLado"/>
            <output expression="&quot;El &#225;rea de un cuadrado de lado, &quot; &amp; lonLado &amp; &quot; es: &quot; &amp; area" newline="True"/>
        </body>
    </function>
</flowgorithm>
