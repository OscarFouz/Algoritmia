<?xml version="1.0"?>
<flowgorithm fileversion="4.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Alumne_tarda1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-17 04:44:30 p. m."/>
        <attribute name="created" value="QWx1bW5lX3RhcmRhMTtMVDJCUzIzNDUyOzIwMjUtMDktMTc7MDM6NDY6NDcgcC4gbS47MzM3NQ=="/>
        <attribute name="edited" value="QWx1bW5lX3RhcmRhMTtMVDJCUzIzNDUyOzIwMjUtMDktMTc7MDQ6NDQ6MzAgcC4gbS47Mjc7MzUzMA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Matriz" type="Integer" array="True" size="6"/>
            <declare name="valor" type="Integer" array="False" size=""/>
            <declare name="mensaje" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="mensaje" expression="&quot;Entre los n&#250;meros &quot;"/>
            <assign variable="valor" expression="0"/>
            <for variable="i" start="0" end="5" direction="inc" step="1">
                <output expression="&quot;Entra un n&#250;mero entero&quot;" newline="True"/>
                <input variable="valor"/>
                <assign variable="Matriz[i]" expression="valor"/>
                <assign variable="mensaje" expression="mensaje &amp; Matriz[i] &amp; &quot;, &quot;"/>
            </for>
            <assign variable="mensaje" expression="mensaje &amp; &quot; hay &quot;"/>
            <assign variable="valor" expression="0"/>
            <for variable="i" start="0" end="5" direction="inc" step="1">
                <if expression="Matriz[i] % 2 = 0">
                    <then>
                        <assign variable="valor" expression="valor + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <assign variable="mensaje" expression="mensaje &amp; valor &amp; &quot; pares &quot;"/>
            <output expression="mensaje" newline="True"/>
        </body>
    </function>
</flowgorithm>
