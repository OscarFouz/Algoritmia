            <input variable="anyNacimiento"/>
            <comment text="C&#225;lculo edad&#13;&#10;"/>
            <assign variable="anys" expression="anyActual - anyNacimiento"/>
            <comment text="Salida "/>
            <output expression="&quot;Hola &quot; &amp; nom &amp; &quot;, tienes &quot; &amp; anys &amp; &quot; a&#241;os&quot;" newline="True"/>
