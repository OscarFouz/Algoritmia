    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="C&#225;lculo de edad a partir del a&#241;o de nacimiento"/>
            <comment text="Declaraci&#243;n de variables"/>
            <declare name="nom" type="String" array="False" size=""/>
            <declare name="edad" type="Integer" array="False" size=""/>
            <declare name="anyNacimiento" type="Integer" array="False" size=""/>
            <declare name="anyActual" type="Integer" array="False" size=""/>
            <comment text="Asignaci&#243;n de valor a variable anyActual"/>
