    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Verificador de Edad para Votaci&#243;n&#13;&#10;Crea un algoritmo que pida la edad a un usuario. Si la edad es 18 o m&#225;s, debe mostrar el mensaje &quot;Puedes votar.&quot;. En caso contrario, no debe mostrar ning&#250;n mensaje."/>
            <declare name="edad" type="Integer" array="False" size=""/>
            <output expression="&quot;Introduce tu edad&quot;" newline="True"/>
            <input variable="edad"/>
            <if expression="edad &gt;= 18">
                <then>
                    <output expression="&quot;Puedes votar&quot;" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
