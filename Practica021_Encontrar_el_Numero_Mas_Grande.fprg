<?xml version="1.0"?>
<flowgorithm fileversion="4.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Alumne_tarda1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-17 05:35:13 p. m."/>
        <attribute name="created" value="QWx1bW5lX3RhcmRhMTtMVDJCUzIzNDUyOzIwMjUtMDktMTc7MDM6NDY6NDcgcC4gbS47MzM3NQ=="/>
        <attribute name="edited" value="QWx1bW5lX3RhcmRhMTtMVDJCUzIzNDUyOzIwMjUtMDktMTc7MDU6MzU6MTMgcC4gbS47MjA7MzUyNQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Encontrar el N&#250;mero M&#225;s Grande&#13;&#10;Crea un algoritmo que pida al usuario 4 n&#250;meros enteros y los guarde en un array. Luego, encuentra y muestra el n&#250;mero m&#225;s grande del array."/>
            <declare name="Matriz" type="Integer" array="True" size="4"/>
            <declare name="valor" type="Integer" array="False" size=""/>
            <declare name="mensaje" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="mensaje" expression="&quot;El valor m&#225;s alto entre &quot;"/>
            <assign variable="valor" expression="0"/>
            <for variable="i" start="0" end="3" direction="inc" step="1">
                <output expression="&quot;Introduce un valor num&#233;rico (entero)&quot;" newline="True"/>
                <input variable="valor"/>
                <assign variable="Matriz[i]" expression="valor"/>
            </for>
            <for variable="i" start="0" end="3" direction="inc" step="1">
                <assign variable="valor" expression="matriz[i]"/>
                <if expression="Matriz[i] &gt; valor">
                    <then>
                        <assign variable="valor" expression="matriz[i]"/>
                    </then>
                    <else/>
                </if>
                <assign variable="mensaje" expression="mensaje &amp; Matriz[i]"/>
                <if expression="i=3">
                    <then/>
                    <else>
                        <assign variable="mensaje" expression="mensaje &amp; &quot;, &quot;"/>
                    </else>
                </if>
            </for>
            <assign variable="mensaje" expression="mensaje &amp; &quot; es: &quot; &amp; valor"/>
            <output expression="mensaje" newline="True"/>
        </body>
    </function>
</flowgorithm>
