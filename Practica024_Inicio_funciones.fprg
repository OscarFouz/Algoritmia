    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Inicio a funciones"/>
            <declare name="n" type="Integer" array="False" size=""/>
            <assign variable="n" expression="5"/>
            <output expression="cuadrado(n)" newline="True"/>
        </body>
    </function>
    <function name="cuadrado" type="Integer" variable="resul">
        <parameters>
            <parameter name="m" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="resul" type="Integer" array="False" size=""/>
            <assign variable="resul" expression="m ^ 2"/>
        </body>
    </function>
