<?xml version="1.0"?>
<flowgorithm fileversion="4.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Alumne_tarda1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-17 04:59:33 p. m."/>
        <attribute name="created" value="QWx1bW5lX3RhcmRhMTtMVDJCUzIzNDUyOzIwMjUtMDktMTc7MDM6NDY6NDcgcC4gbS47MzM3NQ=="/>
        <attribute name="edited" value="QWx1bW5lX3RhcmRhMTtMVDJCUzIzNDUyOzIwMjUtMDktMTc7MDQ6NTk6MzMgcC4gbS47Mjc7MzUzOQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Invertir un Array&#13;&#10;Escribe un algoritmo que declare un array de `String` con 5 elementos (por ejemplo: `[&quot;a&quot;, &quot;b&quot;, &quot;c&quot;, &quot;d&quot;, &quot;e&quot;]`) y muestre los elementos en orden inverso."/>
            <declare name="Matriz" type="String" array="True" size="5"/>
            <declare name="valor" type="String" array="False" size=""/>
            <declare name="mensaje" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="mensaje" expression="&quot;El orden inverso a: &quot;"/>
            <assign variable="valor" expression="&quot;&quot;"/>
            <assign variable="Matriz[0]" expression="&quot;a&quot;"/>
            <assign variable="Matriz[1]" expression="&quot;b&quot;"/>
            <assign variable="Matriz[2]" expression="&quot;c&quot;"/>
            <assign variable="Matriz[3]" expression="&quot;d&quot;"/>
            <assign variable="Matriz[4]" expression="&quot;e&quot;"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <assign variable="mensaje" expression="mensaje &amp; Matriz[i]"/>
                <assign variable="mensaje" expression="mensaje &amp; &quot;, &quot;"/>
            </for>
            <assign variable="mensaje" expression="mensaje &amp; &quot; es: &quot;"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <assign variable="valor" expression="matriz[4-i]"/>
                <assign variable="mensaje" expression="mensaje &amp; valor"/>
                <if expression="i= 4">
                    <then/>
                    <else>
                        <assign variable="mensaje" expression="mensaje &amp; &quot;, &quot;"/>
                    </else>
                </if>
            </for>
            <output expression="mensaje" newline="True"/>
        </body>
    </function>
</flowgorithm>
